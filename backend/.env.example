# Generate a unique secret for production, for example with:
# python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-for-local-development
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173
# For HTTPS production deployments, set DJANGO_DEBUG=false and replace the
# secret, allowed hosts, and frontend origin with deployment-specific values.
# Set DJANGO_SECURE_SSL_REDIRECT=false only when TLS is terminated by a trusted
# reverse proxy that forwards the original HTTPS scheme correctly.
# Leave DATABASE_URL unset to use SQLite locally. For local or production PostgreSQL:
# DATABASE_URL=postgresql://assignment_tracker:change-me@127.0.0.1:5432/assignment_tracker
# Add ?sslmode=require when the PostgreSQL provider requires TLS.
