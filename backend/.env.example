# Generate a unique secret for production, for example with:
# python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-for-local-development
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173
# For HTTPS production deployments, set DJANGO_DEBUG=false and replace the
# secret, allowed hosts, and frontend origin with deployment-specific values.
# Set DJANGO_SECURE_SSL_REDIRECT=false only when TLS is terminated by a trusted
# reverse proxy that forwards the original HTTPS scheme correctly.
# Leave DATABASE_URL unset to use SQLite locally. For local or production PostgreSQL:
# DATABASE_URL=postgresql://assignment_tracker:change-me@127.0.0.1:5432/assignment_tracker
# Add ?sslmode=require when the PostgreSQL provider requires TLS.
# Optional persistent attachment storage (S3-compatible, e.g. Cloudflare R2):
# AWS_STORAGE_BUCKET_NAME=assignment-tracker-uploads
# AWS_S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# AWS_ACCESS_KEY_ID=<R2 access key>
# AWS_SECRET_ACCESS_KEY=<R2 secret key>
# AWS_S3_REGION_NAME=auto
#
# Production reminder worker (Redis connection URL, not the Upstash REST URL):
# CELERY_BROKER_URL=rediss://default:<password>@<host>:<port>
#
# Optional SMTP delivery for reminder emails:
# EMAIL_HOST=<SMTP host>
# EMAIL_PORT=587
# EMAIL_HOST_USER=<SMTP username>
# EMAIL_HOST_PASSWORD=<SMTP password>
# EMAIL_USE_TLS=true
# EMAIL_USE_SSL=false
# DJANGO_DEFAULT_FROM_EMAIL=Student Assignment Tracker <noreply@example.com>
